DATABASE_URL="postgresql://mahjong:mahjong_dev@localhost:5432/mahjong_trainer"

# ── Identity (Cloudflare Access) ────────────────────────────────────────────
# This app runs no OAuth flow of its own — the Cloudflare Tunnel in front of it
# enforces sign-in via a Zero Trust "Access" application, and the app verifies
# the resulting JWT itself (lib/server/cfAccess.ts) to establish identity.
# CF_ACCESS_TEAM_DOMAIN: your team's domain, e.g. "yourteam.cloudflareaccess.com".
# CF_ACCESS_AUD: this app's Access application AUD tag (Zero Trust dashboard →
# Access → Applications → this app → Overview).
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""

# ── Event log (NATS JetStream) ───────────────────────────────────────────────
# Optional — if unset, the app runs fine without durable event persistence
# (rooms just live in memory for the process lifetime). Set this once the
# `nats` service in docker-compose.yml (or a local NATS server) is running.
NATS_URL="nats://localhost:4222"
