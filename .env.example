DATABASE_URL="postgresql://mahjong:mahjong_dev@localhost:5432/mahjong_trainer"

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generate a secret with:  npx auth secret
AUTH_SECRET=""
# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Required for any self-hosted deployment (Auth.js only auto-trusts the Host
# header on Vercel) — without it every request 500s with "UntrustedHost".
# docker-compose.yml already hardcodes this for the `app` service; only
# needed here if running outside docker-compose (e.g. `next start` directly).
AUTH_TRUST_HOST="true"

# ── Event log (NATS JetStream) ───────────────────────────────────────────────
# Optional — if unset, the app runs fine without durable event persistence
# (rooms just live in memory for the process lifetime). Set this once the
# `nats` service in docker-compose.yml (or a local NATS server) is running.
NATS_URL="nats://localhost:4222"
