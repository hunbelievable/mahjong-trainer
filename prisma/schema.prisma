generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id         String       @id @default(cuid())
  mode       String // 'live' | 'simulation' | 'observe' | 'study'
  createdAt  DateTime     @default(now())
  finishedAt DateTime?
  winner     String? // PlayerId or null
  moves      MoveRecord[]
}

model MoveRecord {
  id            String      @id @default(cuid())
  gameId        String
  game          Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  turn          Int
  player        String // PlayerId
  action        String // MoveAction
  tileId        String
  handBefore    String // JSON array of tile IDs
  winProbBefore Float
  winProbAfter  Float
  commentary    String?
  tileEvents    TileEvent[]

  @@index([gameId, turn])
}

model TileEvent {
  id        String     @id @default(cuid())
  moveId    String
  move      MoveRecord @relation(fields: [moveId], references: [id], onDelete: Cascade)
  tileId    String
  fromState String
  toState   String
  actor     String // PlayerId
}

model HandPattern {
  id          String  @id @default(cuid())
  name        String
  difficulty  String // 'starter' | 'medium' | 'hard'
  description String
  groups      String // JSON: PatternGroup[]
  builtIn     Boolean @default(false)
  active      Boolean @default(true)

  @@index([active])
}

// =============================================================================
// Multiplayer — identity (Cloudflare Access) + projections (rooms, matches,
// scoring). The Cloudflare Tunnel in front of this app enforces sign-in via a
// Zero Trust Access application before any request reaches us, so the app
// itself runs no OAuth flow — it just trusts the Access-verified email (JWT,
// see lib/server/cfAccess.ts) as user identity and finds-or-creates a User row
// for it. The event log / authoritative state live in NATS + memory; these
// tables are durable READ MODELS. See docs/multiplayer-design.md §§6, 12, 18.
// =============================================================================

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  /// Multiplayer display handle, shown as "Seat (handle)" — null until the user sets one.
  handle       String?
  createdAt    DateTime      @default(now())
  matchPlayers MatchPlayer[]
  createdRooms Room[]
}

// ── Domain projections ───────────────────────────────────────────────────────

model Room {
  id          String   @id // 6-char join code (matches RoomManager)
  status      String   @default("lobby") // lobby | playing | finished
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  matches     Match[]

  @@index([status])
}

/// A series of games in a room (the doc's "session"; renamed to avoid the Auth.js Session clash).
model Match {
  id        String        @id @default(cuid())
  roomId    String
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  players   MatchPlayer[]
  games     MatchGame[]
}

/// A participant occupying a FIXED physical seat for the whole match; holds the running standings.
model MatchPlayer {
  id            String  @id @default(cuid())
  matchId       String
  match         Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  seat          String // fixed physical seat: E | S | W | N
  userId        String? // null for a CPU seat
  user          User?   @relation(fields: [userId], references: [id])
  isCpu         Boolean @default(false)
  cpuDifficulty String? // beginner | intermediate | advanced (when isCpu)
  score         Int     @default(0) // running zero-sum standings total

  @@unique([matchId, seat])
}

/// One hand within a match — the scoring/rotation read model.
model MatchGame {
  id           String    @id @default(cuid())
  matchId      String
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber   Int
  dealerSeat   String // physical seat that was East/dealer this hand (rest of wind map derives from it)
  winnerSeat   String? // physical seat of the winner, or null on a wall game
  winKind      String? // 'discard' | 'self_draw' | 'wall'
  patternName  String?
  patternValue Int?
  payouts      Json // per physical seat delta, e.g. { "E": +50, "S": -25, "W": -25, "N": 0 }
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@unique([matchId, gameNumber])
  @@index([matchId])
}
