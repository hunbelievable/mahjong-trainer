generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id         String       @id @default(cuid())
  mode       String // 'live' | 'simulation' | 'observe' | 'study'
  createdAt  DateTime     @default(now())
  finishedAt DateTime?
  winner     String? // PlayerId or null
  moves      MoveRecord[]
}

model MoveRecord {
  id            String      @id @default(cuid())
  gameId        String
  game          Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  turn          Int
  player        String // PlayerId
  action        String // MoveAction
  tileId        String
  handBefore    String // JSON array of tile IDs
  winProbBefore Float
  winProbAfter  Float
  commentary    String?
  tileEvents    TileEvent[]

  @@index([gameId, turn])
}

model TileEvent {
  id        String     @id @default(cuid())
  moveId    String
  move      MoveRecord @relation(fields: [moveId], references: [id], onDelete: Cascade)
  tileId    String
  fromState String
  toState   String
  actor     String // PlayerId
}

model HandPattern {
  id          String  @id @default(cuid())
  name        String
  difficulty  String // 'starter' | 'medium' | 'hard'
  description String
  groups      String // JSON: PatternGroup[]
  builtIn     Boolean @default(false)
  active      Boolean @default(true)

  @@index([active])
}

// =============================================================================
// Multiplayer — identity (Cloudflare Access) + projections (rooms, matches,
// scoring). The Cloudflare Tunnel in front of this app enforces sign-in via a
// Zero Trust Access application before any request reaches us, so the app
// itself runs no OAuth flow — it just trusts the Access-verified email (JWT,
// see lib/server/cfAccess.ts) as user identity and finds-or-creates a User row
// for it. The event log / authoritative state live in NATS + memory; these
// tables are durable READ MODELS. See docs/multiplayer-design.md §§6, 12, 18.
// =============================================================================

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  /// Multiplayer display handle, shown as "Seat (handle)" — null until the user sets one.
  handle                String?
  createdAt             DateTime       @default(now())
  matchPlayers          MatchPlayer[]
  createdRooms          Room[]
  commissionedLeagues   League[]       @relation("LeagueCommissioner")
  leagueMemberships     LeagueMember[]
  scoreRecords          ScoreRecord[]  @relation("ScoreRecordSubject")
  enteredScoreRecords   ScoreRecord[]  @relation("ScoreRecordEnteredBy")
}

// ── Domain projections ───────────────────────────────────────────────────────

model Room {
  id          String   @id // 6-char join code (matches RoomManager)
  status      String   @default("lobby") // lobby | playing | finished
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  matches     Match[]
  /// Set when a room is one of a league night's pre-seated tables (Phase 2 auto-feed). Null for an
  /// ordinary multiplayer room. This row may not exist yet at link time (a room's Postgres row is
  /// only created via connectOrCreate when its first Match starts) — linking upserts it.
  leagueSessionId String?
  leagueSession   LeagueSession? @relation(fields: [leagueSessionId], references: [id])

  @@index([status])
}

/// A series of games in a room (the doc's "session"; renamed to avoid the Auth.js Session clash).
model Match {
  id        String        @id @default(cuid())
  roomId    String
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  players   MatchPlayer[]
  games     MatchGame[]
}

/// A participant occupying a FIXED physical seat for the whole match; holds the running standings.
model MatchPlayer {
  id            String  @id @default(cuid())
  matchId       String
  match         Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  seat          String // fixed physical seat: E | S | W | N
  userId        String? // null for a CPU seat
  user          User?   @relation(fields: [userId], references: [id])
  isCpu         Boolean @default(false)
  cpuDifficulty String? // beginner | intermediate | advanced (when isCpu)
  /// Game number during which the seat was converted to CPU (kick/forfeit). userId stays set so
  /// hands played BEFORE this game remain attributable; hands from this game on were CPU-played.
  vacatedAtGame Int?
  score         Int     @default(0) // running zero-sum standings total

  @@unique([matchId, seat])
}

/// One hand within a match — the scoring/rotation read model.
model MatchGame {
  id           String    @id @default(cuid())
  matchId      String
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber   Int
  dealerSeat   String // physical seat that was East/dealer this hand (rest of wind map derives from it)
  winnerSeat   String? // physical seat of the winner, or null on a wall game
  winKind      String? // 'discard' | 'self_draw' | 'wall'
  patternName  String?
  patternValue Int?
  payouts      Json // per physical seat delta, e.g. { "E": +50, "S": -25, "W": -25, "N": 0 }
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@unique([matchId, gameNumber])
  @@index([matchId])
}

// =============================================================================
// League — a separate PRODUCT (standalone value for a club that plays 100%
// physically and never opens the online game), kept in this codebase as a
// cleanly bounded module until a second customer ever exists. Hard boundary:
// league code references User and score records only — never GameRoom, never
// the engine. Postgres is directly authoritative here (unlike Room/Match,
// there's no in-memory runtime this mirrors — manual score entry is
// first-class, not a fallback). See docs/league-handoff.md.
// =============================================================================

model League {
  id                 String         @id @default(cuid())
  name               String
  commissionerUserId String
  commissioner       User           @relation("LeagueCommissioner", fields: [commissionerUserId], references: [id])
  createdAt          DateTime       @default(now())
  members            LeagueMember[]
  seasons            Season[]
}

/// leagueId+userId membership; the commissioner also gets a row here (role="commissioner") so they appear in member listings without special-casing.
model LeagueMember {
  id       String   @id @default(cuid())
  leagueId String
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     String // commissioner | member
  joinedAt DateTime @default(now())

  @@unique([leagueId, userId])
}

/// Open-ended by default (endsAt nullable), matching how a Match's standings already work.
model Season {
  id       String          @id @default(cuid())
  leagueId String
  league   League          @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name     String
  startsAt DateTime        @default(now())
  endsAt   DateTime?
  sessions LeagueSession[]
}

/// One "league night" — deliberately minimal (no RSVP/calendar): the commissioner starts one when everyone's there.
model LeagueSession {
  id          String        @id @default(cuid())
  seasonId    String
  season      Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  scheduledAt DateTime      @default(now())
  label       String?
  scores      ScoreRecord[]
  /// Pre-seated multiplayer rooms for this league night (Phase 2). A league night's ScoreRecords are
  /// synced from these rooms' finished Matches, one row per human player per room (summed across the
  /// room's whole Match — the standings grain is "points for the night," not "points for one hand").
  rooms       Room[]
}

/// The standings aggregation atom. `source` distinguishes manual entry (Phase 1) from the online
/// auto-feed (Phase 2, source="online", matchId set). One row per (sessionId, userId): re-entering
/// (whether by hand or by re-syncing) updates in place rather than duplicating.
model ScoreRecord {
  id              String        @id @default(cuid())
  sessionId       String
  session         LeagueSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation("ScoreRecordSubject", fields: [userId], references: [id])
  points          Int
  source          String // manual | online
  /// Null for manual entries. Set to the multiplayer Match.id once Phase 2 auto-feeds this row — a
  /// whole Match's summed result (see the Room.leagueSessionId comment), not one individual MatchGame.
  matchId         String?
  enteredByUserId String
  enteredBy       User          @relation("ScoreRecordEnteredBy", fields: [enteredByUserId], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([sessionId, userId])
}
